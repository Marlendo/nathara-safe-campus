# Server
PORT=5001

# PostgreSQL connection. Replace postgres:postgres with your real credentials.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/safepath

# Secret used to sign responder JWTs
JWT_SECRET=change-me-safepath-dev-secret
JWT_EXPIRES=8h

# Optional production settings
# NODE_ENV=production
# TRUST_PROXY=true            # set true when behind nginx/ELB (enables rate-limit proxy trust)
# RATE_WINDOW_MS=600000       # rate-limit window (ms)
# RATE_MAX=60                 # max requests per window per IP