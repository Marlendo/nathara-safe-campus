# Server
PORT=5001

# PostgreSQL connection. Replace postgres:postgres with your real credentials.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/safe_campus

# SSO Nathara (prod) — public identifiers, BUKAN secret.
# service_role / JWT rahasia prod HARAM di sini.
SSO_JWKS_URL=https://api.nathara.ac.id/functions/v1/sso-jwks
SSO_ISSUER=https://sso.nathara.ac.id
SSO_AUDIENCE=ppkpt

# Admin awal (seed SSO): sub + email dari file VPS, JANGAN commit nilai asli.
# SEED_ADMIN_SUB=
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_NAME=Safe Campus Admin

# Optional production settings
# NODE_ENV=production
# TRUST_PROXY=true            # set true when behind nginx/ELB (enables rate-limit proxy trust)
# RATE_WINDOW_MS=600000       # rate-limit window (ms)
# RATE_MAX=20                 # max requests per window per IP (spec SA: SSO 20/10 mnt)
# RATE_MAX_SSO=20             # override khusus endpoint sesi SSO (didahulukan atas RATE_MAX)
# RATE_MAX_PUBLIC=20          # override khusus endpoint publik (didahulukan atas RATE_MAX)

# CORS allowlist untuk /api/v1/admin (F2) — koma-bila-lebih-dari-satu.
# ADMIN_CORS_ORIGIN=https://ppkpt.nathara.ac.id
