# Root ops file for `docker compose` (not used by plain npm dev runs).
# Copy to .env and set real values in production:
#   cp .env.example .env

# PostgreSQL database password used by db/api/init services
POSTGRES_PASSWORD=safepath

# JWT signing secret — MUST be a long random value in production:
#   openssl rand -hex 32
JWT_SECRET=change-me-safepath-prod-secret

# Host port for the nginx web service
WEB_PORT=8080