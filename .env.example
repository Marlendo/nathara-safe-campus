# Root ops file for `docker compose` (not used by plain bun dev runs).
# Copy to .env and set real values in production:
#   cp .env.example .env

# DB = cluster SHARED `staging-postgres-18` (SSOT: OVERRIDE human
# "saya yakin" 2026-11-23). TIDAK ada postgres lokal lagi.
# Password DB shared HANYA dari file VPS /home/marlendo/staging/docker/.env
# → SAFE_CAMPUS_DB_PASSWORD. Salin nilainya ke .env lokal (file ini),
# JANGAN commit nilai asli (.env gitignored).
# Contoh DATABASE_URL yang dipakai api/init (placeholder — password
# disubstitusi compose dari SAFE_CAMPUS_DB_PASSWORD):
#   postgres://safe_campus:<password>@staging-postgres-18:5432/safe_campus
# Dependensi: cluster + network `staging-shared` hidup via
# /home/marlendo/staging/docker (docker compose up -d di folder itu).
SAFE_CAMPUS_DB_PASSWORD=

# Arsip jalan-mundur (isolasi lama, pre-shared): JANGAN dipakai compose.
# POSTGRES_PASSWORD=

# SSO Nathara (prod) — public identifiers, BUKAN secret.
SSO_JWKS_URL=https://api.nathara.ac.id/functions/v1/sso-jwks
SSO_ISSUER=https://sso.nathara.ac.id
SSO_AUDIENCE=ppkpt

# Admin awal (seed SSO): sub + email dari file VPS, JANGAN commit nilai asli.
# SEED_ADMIN_SUB=
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_NAME=Safe Campus Admin

# Host port for the nginx web service
WEB_PORT=8080

# Rate limit API (spec SA: SSO 20 req / 10 mnt) — DevOps: samakan file VPS staging.
# RATE_MAX=20

# CORS allowlist untuk /api/v1/admin (F2).
# ADMIN_CORS_ORIGIN=https://ppkpt.nathara.ac.id
