# Root ops file for `docker compose` (not used by plain bun dev runs).
# Copy to .env and set real values in production:
#   cp .env.example .env

# PostgreSQL database password used by db/api/init services
POSTGRES_PASSWORD=safe_campus

# SSO Nathara (prod) — public identifiers, BUKAN secret.
SSO_JWKS_URL=https://api.nathara.ac.id/functions/v1/sso-jwks
SSO_ISSUER=https://sso.nathara.ac.id
SSO_AUDIENCE=ppkpt

# Admin awal (seed SSO): sub + email dari file VPS, JANGAN commit nilai asli.
# SEED_ADMIN_SUB=
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_NAME=Safe Campus Admin

# Host port for the nginx web service
WEB_PORT=8080

# Rate limit API (spec SA: SSO 20 req / 10 mnt) — DevOps: samakan file VPS staging.
# RATE_MAX=20

# CORS allowlist untuk /api/v1/admin (F2).
# ADMIN_CORS_ORIGIN=https://ppkpt.nathara.ac.id
